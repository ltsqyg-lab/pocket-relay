{
  // Most relays need no configuration file: start it, and paste the line it prints into the Pocket App
  // (Settings → Relay → Add your own relay). This file lists the settings with their defaults; keep only what you change.
  // Every value can also come from an environment variable: publicUrl → RELAY_PUBLIC_URL, listen.port → RELAY_LISTEN_PORT…
  // Nothing here is secret. S3 keys (if any) come from the environment variables named below.

  // Leave both out to have the relay claimed from the App (RELAY.md §12.1). Give both only to bind it by hand.
  "relayId": null,
  "account": null,

  // How devices reach the relay. null = ask the coordination server for this server's public IP and use
  // https://<that IP>:<listen.port>. Set it when that is not right: another port outside (docker run -p 443:8443),
  // a domain name, a reverse proxy. No path: the App adds relays only at the root of a host and port.
  "publicUrl": null,
  "listen": { "host": "0.0.0.0", "port": 8443 },

  // "auto": the relay makes its own self-signed certificate (devices pin it, no domain needed); behind a proxy
  // (trustProxy true) plain HTTP instead. Or {"cert": "/etc/pocket-relay/fullchain.pem", "key": "/etc/pocket-relay/privkey.pem"}
  // (reloaded when they change), or null for plain HTTP behind a reverse proxy that terminates TLS.
  "tls": "auto",
  "trustProxy": false,

  // The official coordination server. Its public key is built in (coord.pinnedKeys); change these only for a lab.
  "coord": { "url": "https://pocket.pocketcli.net" },

  "dataDir": "/var/lib/pocket-relay",

  // Attachments on this server's disk (default). For an S3-compatible bucket instead:
  //   "blobs": { "store": "s3", "backends": [ { "name": "main", "when": "default", "endpoint": "https://s3.example.com",
  //     "region": "us-east-1", "bucket": "my-pocket", "accessKeyEnv": "RELAY_S3_KEY", "secretKeyEnv": "RELAY_S3_SECRET",
  //     "pathStyle": false, "prefix": "pocket/" } ] }
  "blobs": { "store": "disk" },

  "timezone": "Asia/Shanghai",
  "quota": { "dayMB": null, "monthMB": null, "storeMB": null, "useTicketQuota": true },
  "retention": { "objectDays": 30, "blobDays": 30, "queueMaxSeconds": 604800 }
}
